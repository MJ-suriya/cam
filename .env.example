# Dahua NVR Cloud Configuration for Render
NVR_IP=your-nvr-public-ip-or-domain.com
RTSP_PORT=554
NVR_USERNAME=admin
NVR_PASSWORD=your_nvr_password

# Stream Quality: 1 = Sub-stream (recommended for multi-cam cloud AI), 0 = Main stream
DEFAULT_SUBTYPE=1

# Application Port (Render sets this automatically)
PORT=8000
